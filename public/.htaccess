# HRAM static Next.js export (trailingSlash) — hram.tr docroot
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # PHP / API / real files must not fall through to SPA index
    RewriteRule ^api/ - [L]
    RewriteRule ^apk(/|$) - [L]
    RewriteRule ^downloads/ - [L]
    RewriteRule ^robots\.txt$ - [L]
    RewriteRule ^sitemap\.xml$ - [L]

    # www → apex (do not touch other domains)
    RewriteCond %{HTTP_HOST} ^www\.hram\.tr$ [NC]
    RewriteRule ^ https://hram.tr%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # English auth aliases → Turkish routes (keep /giris /kayit)
    RewriteRule ^login/?$ /giris/ [L,R=301]
    RewriteRule ^register/?$ /kayit/ [L,R=301]

    # Explicit public routes
    RewriteRule ^gizlilik/?$ gizlilik/index.html [L]
    RewriteRule ^destek/?$ destek/index.html [L]
    RewriteRule ^panel/?$ panel/index.html [L]
    RewriteRule ^giris/?$ giris/index.html [L]
    RewriteRule ^kayit/?$ kayit/index.html [L]
    RewriteRule ^agent/?$ agent/index.html [L]
    RewriteRule ^log/?$ log/index.html [L]
    RewriteRule ^admin/?$ admin/index.html [L]
    RewriteRule ^admin/dashboard/?$ admin/dashboard/index.html [L]
    RewriteRule ^admin/customers/?$ admin/customers/index.html [L]
    RewriteRule ^admin/chat/?$ admin/chat/index.html [L]
    RewriteRule ^admin/tickets/?$ admin/tickets/index.html [L]
    RewriteRule ^admin/transactions/?$ admin/transactions/index.html [L]
    RewriteRule ^admin/desks/?$ admin/desks/index.html [L]
    RewriteRule ^admin/employees/?$ admin/employees/index.html [L]
    RewriteRule ^admin/money/?$ admin/money/index.html [L]
    RewriteRule ^admin/referrals/?$ admin/referrals/index.html [L]
    RewriteRule ^admin/analytics/?$ admin/analytics/index.html [L]
    RewriteRule ^admin/settings/?$ admin/settings/index.html [L]
    RewriteRule ^admin/terminal/?$ admin/terminal/index.html [L]
    RewriteRule ^admin/positions/?$ admin/positions/index.html [L]
    RewriteRule ^admin/blotter/?$ admin/blotter/index.html [L]
    RewriteRule ^admin/risk/?$ admin/risk/index.html [L]

    # Existing file or directory
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Directory index.html
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.*)$ $1/index.html [L]

    # Unknown paths → clean 404 (NOT homepage)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ 404.html [L,R=404]
</IfModule>

ErrorDocument 404 /404.html

Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.(css|js|svg|woff2?|png|jpg|jpeg|gif|ico|webp|apk)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
